{
  "name": "fs-testkit",
  "version": "0.2.0",
  "description": "Testing utilities to write better tests that use the file system",
  "homepage": "https://chadian.github.io/fs-testkit/",
  "keywords": [
    "fs",
    "filesystem",
    "testing"
  ],
  "license": "ISC",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./file.js": "./src/file.js",
    "./dir.js": "./src/dir.js",
    "./sandbox.js": "./src/sandbox.js"
  },
  "type": "module",
  "files": [
    "src",
    "!src/**/*.test.js",
    "!src/**/*.vitest.js",
    "!src/test-utils"
  ],
  "scripts": {
    "lint": "eslint",
    "tsc": "tsc",
    "test": "node --test **/*.test.js",
    "smoke-test": "node smoke-test.js"
  },
  "dependencies": {
    "diff": "^8.0.3",
    "isomorphic-git": "^1.36.3",
    "istextorbinary": "^9.5.0"
  },
  "peerDependencies": {
    "@jest/globals": ">= 28",
    "prettier": "^3.8.1"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.0",
    "@types/diff": "^8.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.1",
    "@types/sinon": "^21.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsdoc": "^62.5.3",
    "globals": "^17.3.0",
    "sinon": "^21.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
